# Environment variables & secrets (NEVER commit to GitHub)
.env
.env.local
.env.*
!.env.example

# Python bytecode & cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyc

# Database files
*.db
*.sqlite3
interviewai.db
instance/

# Node modules
node_modules/

# User Uploads (keep directory structure, ignore user files)
static/uploads/resumes/*
static/uploads/avatars/*
!static/uploads/resumes/.gitkeep
!static/uploads/avatars/.gitkeep
uploads/

# Virtual environments
venv/
env/
.venv/
ENV/

# IDE & OS files
.vscode/
.idea/
.DS_Store
*.swp

# Testing & logs
.pytest_cache/
*.log
